{
  "name": "pagehold",
  "version": "1.0.0",
  "private": true,
  "description": "Private PDF tools that run entirely in the browser.",
  "type": "module",
  "license": "MIT",
  "author": "Vin, Vin's Atelier (https://vwesley.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vincentwesley/pagehold.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node scripts/pw.mjs test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "check:budgets": "node scripts/check-budgets.mjs",
    "knip": "knip",
    "deploy": "npm run build && npx --yes wrangler@4.165.0 deploy",
    "pw": "node scripts/pw.mjs",
    "test:e2e:quick": "node scripts/pw.mjs test --project=chromium",
    "licences": "node scripts/licences.mjs",
    "smoke:prod": "node scripts/pw.mjs --prod test --project=chromium e2e/headers.spec.ts e2e/smoke.spec.ts",
    "acceptance": "node scripts/acceptance.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@embedpdf/pdfium": "2.15.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "fast-check": "4.10.3",
    "knip": "^6.45.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@jsquash/jpeg": "1.6.0",
    "@neslinesli93/qpdf-wasm": "0.3.1",
    "@tesseract.js-data/eng": "1.0.0",
    "fflate": "0.8.3",
    "pdfjs-dist": "6.5.438",
    "tesseract.js-core": "7.0.0"
  }
}
